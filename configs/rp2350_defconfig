# Waveshare RP2350-PiZero (RP2350B, Cortex-M33), booting straight to the
# EmuCON command line on the serial console.  pTOS runs in place from the
# QSPI flash; the UF2 image is copied onto the BOOTSEL drive.  See
# docs/superpowers/plans/2026-09-18-rp2350-port.md.
MACHINE_RP2350=y

# AES 3.40, rather than the 1.40 of TOS 1.04 that everything else
# defaults to.  In the whole tree this changes exactly two things:
# wind_get() gains WF_OWNER (aes/gemwmlib.c compiles it out below 0x330),
# and NUM_WIN goes from 8 to 16.  Programs that ask for the window owner
# get FALSE otherwise, which they read as "no such window".
AES_VERSION=0x0340

# The multi-language image supports every country at run time.  It costs
# flash, not RAM, and there are 16 MB of flash.
# BUILD_UNIQUE_COUNTRY is not set

# No IDE interface, no Line-A emulator (m68k only), no XHDI (m68k only).
CONF_WITH_IDE=n
CONF_WITH_LINEA=n
CONF_WITH_XHDI=n

# The AES and the desktop run on the 320x240 SPI display (see
# CONF_WITH_RP2350_LCD).  Everything an AES process calls -- VDI, BIOS,
# GEMDOS traps and their exception frames -- runs on its private stack;
# 590 LONGs overflowed as soon as the menu bar dropped a menu.
AES_STACK_SIZE=1536

# Kernel debug output (kprintf, KINFO) is off, so that it does not mix
# with the console.  For debugging, DEBUG_PRINT_RS232=y sends it to the
# console UART, which also feeds the USB console.

# Bring-up: heartbeat NMI keeps the USB console alive and reports the PC.
CONF_WITH_RP2350_MONITOR=y
